# SENTINEL — environment template. Copy to .env and fill in. Never commit .env.

# ---------- Local stack ----------
COMPOSE_PROJECT_NAME=sentinel

# S3-compatible object store. Locally served by adobe/s3mock (MinIO images were
# withdrawn from Docker Hub in 2026). Point S3_ENDPOINT at real AWS S3 or a MinIO
# cluster to move to production; only this block changes.
S3_ENDPOINT_URL=http://localhost:9090
S3_ACCESS_KEY_ID=sentinel
S3_SECRET_ACCESS_KEY=sentinel
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_RAW=sentinel-raw
S3_BUCKET_BRONZE=sentinel-bronze
S3_BUCKET_SILVER=sentinel-silver

# Postgres (Airflow metadata + local dev warehouse)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-postgres

# ClickHouse (analytical store for the dashboards)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=sentinel
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-clickhouse

# Metabase (BI, dashboards defined as code)
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@sentinel.local
METABASE_ADMIN_PASSWORD=change-me-metabase

# Airflow
AIRFLOW_HOME=./orchestration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://sentinel:change-me-postgres@localhost:5432/sentinel
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW__CORE__LOAD_EXAMPLES=false

# ---------- Ingestion ----------
SCRAPE_USER_AGENT=SENTINEL/1.0 (+https://github.com/SandiRidwan/sentinel-platform; respectful crawler)
SCRAPE_MAX_CONCURRENCY=8
SCRAPE_DOWNLOAD_DELAY=1.0
SCRAPE_OBEY_ROBOTS=true
GO_FETCHER_URL=http://localhost:8088
FINGERPRINT_PROFILE=chrome
FINGERPRINT_PLATFORM=windows
FETCHER_RATE_PER_SECOND=5
FETCHER_MAX_CONCURRENCY=16
FETCH_ALLOWED_HOSTS=books.toscrape.com,quotes.toscrape.com,scrapethissite.com

# ---------- Warehouse targets (cloud, optional) ----------
# dbt target: dev | bigquery | snowflake   (dev = duckdb, no cloud needed)
DBT_TARGET=dev
DUCKDB_PATH=./data/warehouse/sentinel.duckdb

# BigQuery (optional, free tier)
GCP_PROJECT=
BIGQUERY_DATASET=sentinel
GOOGLE_APPLICATION_CREDENTIALS=

# Snowflake (optional, trial)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=SENTINEL
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_SCHEMA=GOLD

# ---------- Governance ----------
OPENLINEAGE_URL=http://localhost:5000
PII_MASK_ENABLED=true
RETENTION_DAYS_RAW=90
RETENTION_DAYS_GOLD=730

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sentinel
