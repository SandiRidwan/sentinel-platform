# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- dbt ---
transform/dbt/target/
transform/dbt/dbt_packages/
transform/dbt/logs/
transform/dbt/.user.yml

# --- Airflow ---
orchestration/logs/
airflow.cfg
airflow.db
webserver_config.py

# --- Iceberg catalog + bench output ---
# The catalog is a SQLite file inside data/iceberg; *.parquet above covers the data files
# but not the catalog itself, and a committed catalog would point at paths that do not
# exist on anyone else's machine.
data/iceberg/
data/staging/zones/silver/books_bench/
edge/node_modules/

# --- Spark / Iceberg / warehouse ---
spark-warehouse/
metastore_db/
derby.log
*.parquet
data/lake/
data/warehouse/

# --- secrets ---
.env
*.pem
*.key
credentials.json
service-account*.json
# dbt profiles. The broad rule exists because ~/.dbt/profiles.yml normally holds
# credentials; this repository copy contains only env_var() references, and without
# it a fresh clone and CI both fail with 'Could not find profile named sentinel'.
profiles.yml
!transform/dbt/profiles.yml

# --- infra state ---
*.tfstate
*.tfstate.*
.terraform/
crash.log
tfplan
tfplan.*
# dev.tfvars holds no credentials (enable_cloud_resources = false, empty project/account
# fields), and CI needs it to run 	erraform plan -var-file=dev.tfvars. Real values live
# in environment variables, so the file is tracked while every other tfvars stays ignored.
*.tfvars
!infra/terraform/dev.tfvars

# --- stray local artefacts ---
# A zero-byte DuckDB file left behind by a test run and a saved plan are not source.
catalog_test.db

# --- build / tooling ---
node_modules/
bin/
*.exe
dist/
.DS_Store
Thumbs.db

# --- reports (generated, tracked selectively) ---
quality/reports/*.json
quality/reports/*.csv
quality/reports/*.jsonl
!quality/reports/.gitkeep
governance/lineage/events/*.jsonl
!governance/lineage/events/.gitkeep
