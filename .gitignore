# --- Iceberg catalog + bench output ---
# The catalog is a SQLite file inside data/iceberg; *.parquet above covers the data files
# but not the catalog itself, and a committed catalog would point at paths that do not
# exist on anyone else's machine.
data/iceberg/
data/staging/zones/silver/books_bench/
edge/node_modules/

# --- Spark / Iceberg / warehouse ---
spark-warehouse/
metastore_db/
derby.log
*.parquet
data/lake/
data/warehouse/

